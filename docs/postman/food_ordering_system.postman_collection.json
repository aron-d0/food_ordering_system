{
  "info": {
    "name": "Food Ordering System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "token", "value": "" },
    { "key": "food_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Login - Generate Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin\"\n}"
        },
        "url": "{{base_url}}/api/login"
      }
    },
    {
      "name": "GET Foods - Without Token Should Fail",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/foods"
      }
    },
    {
      "name": "GET Foods",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{base_url}}/api/foods"
      }
    },
    {
      "name": "POST Create Food",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Burger Steak Meal\",\n  \"category\": \"Rice Meals\",\n  \"price\": 129,\n  \"description\": \"Burger steak with rice and gravy.\",\n  \"stock_quantity\": 20,\n  \"is_available\": 1,\n  \"image_url\": \"images/gravy-chicken-chop-with-plain-rice.png\"\n}"
        },
        "url": "{{base_url}}/api/foods"
      }
    },
    {
      "name": "PUT Update Food",
      "request": {
        "method": "PUT",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Burger Steak Meal\",\n  \"category\": \"Rice Meals\",\n  \"price\": 139,\n  \"description\": \"Updated burger steak with rice and gravy.\",\n  \"stock_quantity\": 15,\n  \"is_available\": 1,\n  \"image_url\": \"images/gravy-chicken-chop-with-plain-rice.png\"\n}"
        },
        "url": "{{base_url}}/api/foods/{{food_id}}"
      }
    },
    {
      "name": "DELETE Food",
      "request": {
        "method": "DELETE",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{base_url}}/api/foods/{{food_id}}"
      }
    },
    {
      "name": "Logout - Revoke Token",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{base_url}}/api/logout"
      }
    }
  ]
}
